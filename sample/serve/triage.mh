// A second workflow — `mhl serve mcp` publishes one MCP tool per
// pipeline/workflow it finds under the directory.

pipeline Triage {
    description: "Classify an incoming issue as normal or urgent from its title and body."

    input title: string
    input body: string

    var priority = "normal"

    step Classify {
        if (title.contains("outage") || body.contains("down")) {
            priority = "urgent"
        }
    }
}
