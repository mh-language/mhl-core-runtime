// A deliberately multi-step workflow, for the async HTTP surface of
// `mhl serve mcp --http`. Each step pauses ~1s so that, after
//
//   run/start {"name":"Report","arguments":{"topic":"caching"}}
//
// a `run/status {"runId": ...}` poll visibly reports `step` advancing
// Gather -> Analyze -> Summarize -> Publish (with `stepIndex`/`stepTotal`
// and the ordered `reached` list), then returns the final `vars` once
// `state` is `completed`. `run/cancel` stops it between steps.
//
// A plain `tools/call` runs it the same way but blocks the HTTP request for
// the whole ~4s instead.

pipeline Report {
    description: "Four-step report pipeline (gather, analyze, summarize, publish)."

    input topic: string

    var gathered = ""
    var analysis = ""
    var summary = ""
    var published = ""

    step Gather {
        gathered = cmd.exec(["sh", "-c", "sleep 1; echo notes on ${topic}"]).stdout
    }

    step Analyze {
        analysis = cmd.exec(["sh", "-c", "sleep 1; echo analyzed"]).stdout + " " + gathered
    }

    step Summarize {
        summary = cmd.exec(["sh", "-c", "sleep 1; echo summary of ${topic}"]).stdout
    }

    step Publish {
        published = "published: " + summary
    }
}
