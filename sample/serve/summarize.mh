// A workflow exposed as an MCP tool by `mhl serve mcp sample/serve`.
// Its `input name: Type` declarations become the tool's JSON Schema; the
// final variable state comes back as the tool result.

agent Writer {
    command: "echo"
    args: ["${prompt}"]
}

pipeline Summarize {
    description: "Summarize a topic in at most `max_words` words."

    input topic: string
    input max_words: number

    var summary = ""

    step Draft {
        summary = Writer.run(prompt: "Summarize ${topic} in ${max_words} words.")
    }
}
