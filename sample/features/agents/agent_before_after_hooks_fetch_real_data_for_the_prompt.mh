// Echo prints whatever prompt mhl built for it — no real LLM call involved.
// GitHub is a mocked stdio MCP extension standing in for a real one; see
// sample/features/mcp/ for the same wiring against the real GitHub MCP
// server.
agent Echo {
    command: "echo"
    args: ["${prompt}"]

    // `before` runs once, right before the prompt is built. Its body is an
    // ordinary expression scope — it resolves declared `tool`/`extension`
    // names by name, calls native ops, reads `mem`, sees the calling step's
    // vars — and its returned object's fields become "${...}" bindings the
    // prompt argument can interpolate. Real fetched data, not a hope that
    // the model reads and acts on an instruction.
    before: () -> {
        var mcp_result = GitHub.call("search_repositories", { query: "mhl" })
        var tool_result = execution.read_file("README.md")
        return { mcp_result: mcp_result, tool_result: tool_result }
    }

    // `after` runs once, on whichever leg (primary or fallback) produced the
    // final response. The response is bound as `result`. A plain side effect
    // here; a non-nil string return would replace what `.run()` gives back.
    after: () -> {
        log("agent responded with ${result.size()} character(s)")
    }
}

tool execution {
    read_file(path: string) -> "contents of " + path
}

extension mcp GitHub {
    transport: "stdio"
    command: "sh"
    args: ["-c", "read _; printf '{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"total_count\":3}}'"]
}

test agent_before_after_hooks_fetch_real_data_for_the_prompt {
    describe agent_before_after_hooks_fetch_real_data_for_the_prompt {
        var response = Echo.run(prompt: "mcp says ${mcp_result}, tool says ${tool_result}")
        log(response)
        is_true(response.contains("mcp says {\"total_count\":3}"))
        is_true(response.contains("tool says contents of README.md"))
    }
}
