// Echo prints whatever prompt mhl built for it — no real LLM call involved.
// GitHub/Jira are mocked stdio MCP extensions standing in for real ones.
agent Echo {
    command: "echo"
    args: ["${prompt}"]

    // A `before` hook body is an ordinary expression scope: it calls any
    // declared tool or extension by name, as many as it needs. The returned
    // object's fields become "${...}" bindings for the prompt.
    before: () -> {
        return {
            file_result: execution.read_file("main.go"),
            json_result: storage.write_json("main.go"),
            github_result: GitHub.call("search", {}),
            jira_result: Jira.call("search", {})
        }
    }
}

tool execution {
    read_file(path: string) -> "execution read " + path
}

tool storage {
    write_json(path: string) -> "storage wrote " + path
}

extension mcp GitHub {
    transport: "stdio"
    command: "sh"
    args: ["-c", "read _; printf '{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"github-result\"}'"]
}

extension mcp Jira {
    transport: "stdio"
    command: "sh"
    args: ["-c", "read _; printf '{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"jira-result\"}'"]
}

test agent_before_hook_fetches_from_multiple_tools_and_extensions {
    describe agent_before_hook_fetches_from_multiple_tools_and_extensions {
        var response = Echo.run(prompt: "${file_result} | ${json_result} | ${github_result} | ${jira_result}")
        log(response)
        is_true(response.contains("execution read main.go"))
        is_true(response.contains("storage wrote main.go"))
        is_true(response.contains("github-result"))
        is_true(response.contains("jira-result"))
    }
}
