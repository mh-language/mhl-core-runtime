// Echo prints whatever prompt mhl built for it — no real LLM call involved.
// GitHub/Jira are mocked stdio MCP servers standing in for real ones.
agent Echo {
    command: "echo"
    args: ["${prompt}"]
    tools: [execution, storage]
    mcp_servers: [GitHub, Jira]

    // `mcp`/`tool` are maps keyed by declared name, one entry per item in
    // `mcp_servers:`/`tools:` — every declared tool/server is reachable,
    // not just the first one.
    before: (mcp, tool) -> {
        return {
            file_result: tool.execution.read_file("main.go"),
            json_result: tool.storage.write_json("main.go"),
            github_result: mcp.GitHub.call("search", {}),
            jira_result: mcp.Jira.call("search", {})
        }
    }
}

tool execution {
    read_file(path: string) -> "execution read " + path
}

tool storage {
    write_json(path: string) -> "storage wrote " + path
}

mcp_server GitHub {
    transport: "stdio"
    command: "sh"
    args: ["-c", "read _; printf '{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"github-result\"}'"]
}

mcp_server Jira {
    transport: "stdio"
    command: "sh"
    args: ["-c", "read _; printf '{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"jira-result\"}'"]
}

test agent_before_hook_navigates_multiple_tools_and_mcp_servers {
    describe agent_before_hook_navigates_multiple_tools_and_mcp_servers {
        var response = Echo.run(prompt: "${file_result} | ${json_result} | ${github_result} | ${jira_result}")
        log(response)
        is_true(response.contains("execution read main.go"))
        is_true(response.contains("storage wrote main.go"))
        is_true(response.contains("github-result"))
        is_true(response.contains("jira-result"))
    }
}
