// Echo prints whatever prompt mhl built for it — no real LLM call involved.
agent Echo {
    command: "echo"
    args: ["${prompt}"]
    tools: [execution]
    mcp_servers: [Repository]
}

tool execution {
    read_file(path: string) -> fs.read(path)
}

mcp_server Repository {
    transport: "stdio"
    command: "true"
}

test agent_tools_and_mcp_servers_fold_into_the_prompt {
    describe agent_tools_and_mcp_servers_fold_into_every_run {
        // An agent's own `tools:`/`mcp_servers:` properties shape every
        // `.run()` call's prompt with an explicit allowed-scope
        // instruction — best-effort only (mhl has no structural channel to
        // enforce it against a CLI-backed agent), but no longer silently
        // ignored the way they used to be.
        var response = Echo.run(prompt: "hello")
        log(response)
        is_true(response.contains("[ALLOWED SCOPE]"))
        is_true(response.contains("tools: execution"))
        is_true(response.contains("mcp_servers: Repository"))
        is_true(response.contains("hello"))
    }
}
