# Loaded by `make functional-test` via --env-file (see README.md). Real
# environment variables win over these.
MHL_SAMPLE_GREETING=hello from sample.env   # unquoted: trimmed, " #" starts a comment
export MHL_SAMPLE_MODEL="gemini-2.5-flash"
MHL_SAMPLE_QUOTED="line one\nline two"
MHL_SAMPLE_LITERAL='$HOME stays as written'
MHL_SAMPLE_EMPTY=
