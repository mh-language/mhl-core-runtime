// The second fragment of ReviewFlow (see ../review_flow.mh). Graphed alone
// it has no start edge — a run never starts here: Draft, in the entry
// fragment, falls through into Review.
partial workflow ReviewFlow {
    step Review {
        if (!approved) {
            pause("approve the draft: resume with approved=true")
        }
    }

    step Publish {
        self.status = "published"
        complete()
    }
}
