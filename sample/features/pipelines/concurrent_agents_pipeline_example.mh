// Concurrent sub-agents inside one step: `spawn` starts an agent call in the
// background and binds a task handle; `wait` joins the handles. The whole run
// is capped at `max_concurrency` agent calls in flight at once. Run with:
//
//   mhl run sample/features/pipelines/concurrent_agents_pipeline_example.mh --input topic=caching

agent Fast {
    command: "sh"
    args: ["-c", "echo fast-reply"]
}

agent Slow {
    command: "sh"
    args: ["-c", "sleep 0.2; echo slow-reply"]
}

agent Flaky {
    command: "sh"
    args: ["-c", "echo nope >&2; exit 1"]
}

pipeline ConcurrentReview {
    input topic: string

    spawn: { max_concurrency: 2 }

    // wait-all: every handle is joined in spawn order; a failing agent would
    // fail the step (fail-fast) unless `on_error: "collect"` is given.
    step FanOut {
        spawn a = Fast.run(prompt: "angle one: ${topic}")
        spawn b = Fast.run(prompt: "angle two: ${topic}")
        spawn c = Slow.run(prompt: "angle three: ${topic}")

        wait a, b, c timeout: 10s

        log("a => ${a.result} (${a.status})")
        log("b => ${b.result}")
        log("c => ${c.result}")
    }

    // fan-out over the SAME agent, one spawn per item.
    step SameAgentFanOut {
        var items = ["readme", "changelog"]
        spawn r0 = Fast.run(prompt: "check ${items[0]}")
        spawn r1 = Fast.run(prompt: "check ${items[1]}")
        wait r0, r1
        log("r0.ok=${r0.ok} r1.ok=${r1.ok}")
    }

    // `on_error: "collect"` keeps the step green and leaves the outcome on
    // each handle; `wait any` returns as soon as one succeeds.
    step Tolerant {
        spawn ok = Fast.run(prompt: "${topic}")
        spawn bad = Flaky.run(prompt: "${topic}")
        wait ok, bad on_error: "collect"
        log("ok.status=${ok.status} bad.status=${bad.status} bad.error=${bad.error}")

        spawn q1 = Slow.run(prompt: "${topic}")
        spawn q2 = Fast.run(prompt: "${topic}")
        wait any q1, q2
        log("first done: q1.ok=${q1.ok} q2.ok=${q2.ok}")
    }
}
