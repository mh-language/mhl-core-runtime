// Minimal case for a `loop pipeline`: repeat a pipeline until a step decides
// it is done, with a `max <N>` header clause as the safety ceiling. Run with:
//
//   mhl run sample/features/pipelines/loop_poll_pipeline_example.mh
//
// The step ends the whole loop with `break "reason"` once the condition
// holds — it sees every variable, like any step code. (`complete()` would
// only end the current iteration.) Without the marker file, the loop stops
// at the ceiling: terminal_reason "max_iterations".

loop pipeline PollForReady max 5 {
    step Check {
        log.info("[poll] checking readiness marker...")
        var ready = fs.exists(".mhl/ready.marker")
        var status = if (ready) "done" else "pending"
        log.info("[poll] status: ${status}")
        if (ready) break "ready"
    }
}
