# BuildKit reads "<dockerfile>.dockerignore" next to the Dockerfile, so this
# only scopes `docker build -f sample/cloud/Dockerfile .` — nothing else.
# Keep the build context to just the Go module and the two workflows.
*
!src/mhl-runtime/**
!sample/cloud/docs-workflow.mh
!sample/cloud/slow-build.mh

# never ship these even from the allowed paths
**/.git
**/.DS_Store
src/mhl-runtime/dist/**
src/mhl-runtime/**/testdata/**
