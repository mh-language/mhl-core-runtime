// The Specification phase of Story (see ../review_cycle_with_stages_and_gates.mh).
import {SpecReview} from "review.mh"

partial workflow Story stage Specification {
    step DraftSpec {
        base.spec_rounds = base.spec_rounds + 1
    }

    step ApproveSpec {
        var d = pause("approve spec round ${base.spec_rounds}", decision: SpecReview)
        if (!d.approved) {
            goto Specification
        }

        goto Implementation
    }
}
