test optional_member_on_non_object_raises {
    describe optional_member_on_non_object_raises {
        var result = ""
        try {
            var s = "plain string"
            // `?.` only guards against null / missing field — reaching into a
            // non-object is still a type error.
            var bad = s?.field
            result = "no error"
        } catch (e) {
            result = "Caught exception: ${e}"
        }
        are_equal(result, "Caught exception: cannot access field \"field\" on a string value")
    }
}
