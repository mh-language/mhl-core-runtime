test slice_array {
    describe slice_array {
        var numbers = [0, 10, 20, 30, 40, 50, 60]

        // Extract items from index 1 to 4 (excludes index 4) -> [10, 20, 30]
        var slice1 = numbers[1..4]
        are_equal(slice1, [10, 20, 30])

        // Extract from index 3 to the end -> [30, 40, 50, 60]
        var slice2 = numbers[3..]
        are_equal(slice2, [30, 40, 50, 60])

        // Extract from the start up to index 3 -> [0, 10, 20]
        var slice3 = numbers[..3]
        are_equal(slice3, [0, 10, 20])

        // Use the hat (^) operator to get the last 3 items -> [40, 50, 60]
        var slice4 = numbers[^3..]
        are_equal(slice4, [40, 50, 60])

        // an out-of-range end bound clamps to the array's size rather than erroring
        var slice5 = numbers[3..100]
        are_equal(slice5, [30, 40, 50, 60])

        // both bounds omitted copies the whole array
        var slice6 = numbers[..]
        are_equal(slice6, numbers)

        // slicing does not mutate the source array
        are_equal(numbers.size(), 7)
    }
}
