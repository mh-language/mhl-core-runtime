test array_slice_assignment_is_rejected {
    describe array_slice_assignment_is_rejected {
        var numbers = [0, 10, 20, 30]
        var result = ""
        try {
            numbers[1..3] = [99]
            result = "no error"
        } catch (e) {
            result = "Caught exception: ${e}"
        }
        are_equal(result, "Caught exception: assignment target must be a plain variable or an array index, not a nested field")
    }
}
