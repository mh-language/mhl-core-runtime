test conditional_symbols {
    describe conditional_symbols {
        var valueA = 2 < 1
        are_equal(valueA, false)

        var valueB = 2 > 1
        are_equal(valueB, true)

        var valueC = 2 <= 1
        are_equal(valueC, false)

        var valueD = 2 >= 1
        are_equal(valueD, true)

        var valueE = 2 == 1
        are_equal(valueE, false)

        var valueF = 2 != 1
        are_equal(valueF, true)
    }
}
