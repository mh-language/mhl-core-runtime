export agent Codex {
    engine: "cli/codex"
    command: "codex"
    log: ".mhl/logs/codex.log"
    args: [
        "exec",
        //"--sandbox", "workspace-write",
        "--approve-for-me",
        "--json",
        "--output-schema", "${schema}",
        "--",
        "${prompt}"
    ]

    retry: {
        max_attempts: 1
        delay: 5s
    }
}

export agent CodexWithoutSchema {
    engine: "cli/codex"
    command: "codex"
    log: ".mhl/logs/codex.log"
    args: [
        "exec",
        //"--sandbox", "workspace-write",
        "--approve-for-me",
        "--json",
        "--",
        "${prompt}"
    ]

    retry: {
        max_attempts: 1
        delay: 5s
    }
}

export tool CodexAdapter {
    // Executes a query using the Codex agent and returns the result.
    execute(query, schema) -> {
        try {
            var raw = Codex.run(prompt: query, schema: schema)
            var usage = self.extract_usage(raw)
            log("[dev] codex usage: ${json.stringify(usage)}")
            return self.extract_result(raw)
        } catch (e) {
            log.error("[dev] failed to execute codex query: ${e}")
            return null
        }
    }

    executeWithoutSchema(query) -> {
        try {
            var raw = CodexWithoutSchema.run(prompt: query)
            var usage = self.extract_usage(raw)
            log("[dev] codex usage: ${json.stringify(usage)}")
            return self.extract_result(raw)
        } catch (e) {
            log.error("[dev] failed to execute codex query: ${e}")
            return null
        }
    }    

    get_plan_schema_path() -> {
        var schemaPath = ".mhl/plan_schema.json"

        if (fs.exists(schemaPath)) {
            return schemaPath
        }

        fs.write(schemaPath, "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"feature_list.schema.json\",\"title\":\"FeatureList\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"features\"],\"properties\":{\"features\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/feature\"}}},\"$defs\":{\"feature\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"dependsOn\",\"description\",\"id\",\"implementationContext\",\"priority\",\"references\",\"status\",\"title\"],\"properties\":{\"dependsOn\":{\"type\":\"array\",\"items\":{\"type\":\"integer\"},\"description\":\"Ids of features that must complete before this one.\"},\"description\":{\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"implementationContext\":{\"$ref\":\"#/$defs/implementationContext\"},\"priority\":{\"type\":\"integer\"},\"references\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"Flat list of requirement/ADR/AC/interface/design/IC ids cited by this feature.\"},\"status\":{\"type\":\"string\",\"enum\":[\"pending\",\"in_progress\",\"completed\",\"blocked\"]},\"title\":{\"type\":\"string\"}}},\"implementationContext\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"acceptance\",\"constraints\",\"decisions\",\"files\",\"requirements\"],\"properties\":{\"acceptance\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"constraints\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"decisions\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"files\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"requirements\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}}}}}")
        
        return schemaPath        
    }

    get_setup_schema_path() -> {
        var schemaPath = ".mhl/setup_schema.json"

        if (fs.exists(schemaPath)) {
            return schemaPath
        }

        fs.write(schemaPath, json.stringify({
            "type": "object",
            "properties": {
                "TARGET_DIR": {"type": "string"},
                "VERIFY_CMD": {"type": "string"}
            },
            "required": ["TARGET_DIR", "VERIFY_CMD"],
            "additionalProperties": false
        }))
        
        return schemaPath        
    }

    extract_result(raw) -> {
        var events = json.parse_lines(raw)
        var completed = events.filter((e) -> e.type == "item.completed")
        var agentMessages = completed.filter((e) -> e.item.type == "agent_message")
        return agentMessages[agentMessages.size() - 1].item.text
    }    

    extract_usage(raw) -> {
        try{
            var events = json.parse_lines(raw)
            var completed = events.filter((e) -> e.type == "item.completed")
            var usage = completed.filter((e) -> e.usage != null)

            return if (usage.size() == 0) null else {
                input_tokens: usage[0].input_tokens,
                cached_input_tokens: usage[0].cached_input_tokens,
                cache_write_input_tokens: usage[0].cache_write_input_tokens,
                output_tokens: usage[0].output_tokens,
                reasoning_output_tokens: usage[0].reasoning_output_tokens,
            }
        } catch (e) {
            log.error("[dev] failed to extract codex usage from raw output: ${e}")
            return null
        }
    }    
}