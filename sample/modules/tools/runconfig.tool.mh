export memory RunConfigMemory {
    type: "json"
    path: ".mhl/run_config.json"
}

export tool RunConfig {

    setup(raw: any) -> {

        try{
            var target_dir = raw.TARGET_DIR
            var verify_cmd = raw.VERIFY_CMD

            self.set("target_dir", target_dir)
            self.set("verify_cmd", verify_cmd)
            
            return true
        } catch (e) {
            log.error("[dev] failed to set up RunConfig: ${e}")
            return false
        }
    }

    getConfig() -> { 
        var config = RunConfigMemory.get("config", null)
        if (config == null) {
            config = {}
            RunConfigMemory.set("config", config)
        }        
        return config
    }

    get(key: string, defaultValue: any) -> {
        try {
            var value = self.getConfig()[key]
            if (value == null) {
                return defaultValue
            }
            return value
        } catch (e) {
            return defaultValue
        }
        return self.getConfig()[key] 
    }

    set(key: string, value: any) -> {
        var config = self.getConfig()
        config[key] = value
        RunConfigMemory.set("config", config)
    }

    reset() -> RunConfigMemory.set("config", null)
}