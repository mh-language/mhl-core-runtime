/**
Key/value backend for `mhl serve mcp --http` durable state (sessions + run
checkpoints + owners), stored one row per key in a PostgreSQL table
`(key text primary key, value jsonb, updated_at timestamptz)`. `put` is an
atomic INSERT ... ON CONFLICT DO UPDATE.
**/
extensible store {
    manifest: {
        id: "dev.mhl.store-postgres",
        version: "0.1.0",
        api_version: "1",
        executable: "bin/mhl-store-postgres",
        permissions: {
            network: ["*"],
            secrets: []
        }
    }

    properties: {
        dsn: string /// Full connection string (URL "postgres://user:pass@host:port/db?sslmode=..." or libpq keyword/value). Wins over the discrete fields. Use env("DATABASE_URL").
        host: string /// Database host (used when `dsn` is not set).
        port: string /// Database port. Default 5432.
        dbname: string /// Database name.
        user: string /// Role name.
        password: string /// Role password. Use env("PGPASSWORD"); the host resolves and redacts it.
        sslmode: string /// libpq sslmode: disable | prefer (default) | require | verify-ca | verify-full.
        table: string /// Target table. Default "mhl_store". May be schema-qualified ("schema.table"). Identifier characters only.
        prefix: string /// Optional key namespace within the table (stored/stripped transparently). Default "" — the table already isolates state.
        max_conns: number /// Connection pool size. Default 8.
        statement_timeout: string /// Per-statement server-side timeout as a Go duration ("10s", "500ms"). Unset = server default.
        auto_migrate: bool /// Run CREATE TABLE / CREATE INDEX IF NOT EXISTS on first use. Default true. Set false when the schema is managed externally.
        log: string /// Optional path to append a JSON-lines wire trace (one line per handled message) for debugging.
    }

    get(key: string) -> any /// The value at key, or null when no row.
    put(key: string, value: any) -> void /// Upsert value at key (INSERT ... ON CONFLICT DO UPDATE).
    delete(key: string) -> void /// Delete the row. An absent key is not an error.
    list(prefix: string) -> string[] /// Every key with the given prefix (indexed key LIKE prefix || '%', ordered).

    put_if_absent(key: string, value: any) -> bool /// Insert value at key only when no row exists (INSERT ... ON CONFLICT DO NOTHING). Returns whether the row was created. Part of the "cas" capability the mhl serve layer uses for cross-replica run locking.
    compare_and_swap(key: string, expected: any, value: any) -> bool /// Replace value at key with `value` only when the current value equals `expected` under jsonb equality. Returns whether the swap happened. `expected` is typically the exact result of a prior `get`. Part of the "cas" capability.

    claim_next(prefix: string, holder: string) -> any /// Atomically move one `run/<id>/status` row under `prefix` whose value ->>'state' is "pending" (oldest by ->>'startedAt') to "claimed" with ->>'holder' = holder, using SELECT ... FOR UPDATE SKIP LOCKED. Returns {key, value} of the updated row, or null when nothing is pending. Part of the "claim" capability — the mhl serve durable-intake claim loop uses it in place of the generic CAS scan.

    put_fenced(key: string, value: any, lock_key: string, holder: string, token: string) -> bool /// Upsert value at key in one atomic statement, only while the lease row at lock_key still has value->>'holder' = holder AND value->>'token' = token AND is unexpired. Returns whether the lease was still ours (the write landed). Part of the "fence" capability — mhl serve fences checkpoint writes so a replica taken over after a stall cannot corrupt the successor's state.
    delete_fenced(key: string, lock_key: string, holder: string, token: string) -> bool /// Delete key under the same lease condition as put_fenced. Returns whether the lease was still ours (an absent key with the lease held is still a success). Part of the "fence" capability.

    list_statuses(prefix: string) -> any /// Every `run/<id>/status` row under `prefix` as an array of {key, value}, in one query — the mhl serve durable-intake reconcile and sweep loops use this instead of `list` + a `get` per run. Part of the "scan" capability.
    count_pending(prefix: string) -> number /// How many `run/<id>/status` rows under `prefix` have value->>'state' = "pending" — the fleet-wide durable-intake queue depth, served by the pending partial index. Part of the "scan" capability.
}
