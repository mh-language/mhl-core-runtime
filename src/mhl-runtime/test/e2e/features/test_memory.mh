use {SessionJsonMem, AuditLogMem} from "fixtures/memory.mh"

test test_memory {
    describe memory_session_mem {
        SessionJsonMem.set("key1", "value1")
        are_equal(SessionJsonMem.get("key1"), "value1")
    }

    describe memory_session_mem_with_non_existent_key {
        var value = SessionJsonMem.get("non_existent_key")
        are_equal(value, null) // Accessing a non-existent key returns null
    }

    describe memory_session_mem_with_overwrite {
        SessionJsonMem.set("key1", "value1")
        SessionJsonMem.set("key1", "value2") // Overwriting the value of an existing key
        are_equal(SessionJsonMem.get("key1"), "value2")
    }

    describe memory_session_mem_add_object {
        SessionJsonMem.set({"key1": "value1", "key2": "value2"})
        are_equal(SessionJsonMem.get("key1"), "value1")
        are_equal(SessionJsonMem.get("key2"), "value2")
    }

    describe memory_session_mem_add_object_with_overwrite {
        SessionJsonMem.set({"key1": "value1", "key2": "value2"})
        SessionJsonMem.set({"key1": "new_value1"}) // Overwriting the value of an existing key
        are_equal(SessionJsonMem.get("key1"), "new_value1")
        are_equal(SessionJsonMem.get("key2"), "value2")
    }

    describe memory_session_mem_with_delete {
        SessionJsonMem.set({"key3": "value3", "key4": "value4"})
        SessionJsonMem.remove("key3")
        are_equal(SessionJsonMem.get("key3"), null)
        are_equal(SessionJsonMem.get("key4"), "value4")
    }

    describe memory_session_mem_with_nested_object {
        SessionJsonMem.set({"nested": {"key1": "value1", "key2": "value2"}})
        are_equal(SessionJsonMem.get("nested").key1, "value1")
        are_equal(SessionJsonMem.get("nested").key2, "value2")
    }

    describe memory_session_mem_with_nested_delete {
        SessionJsonMem.set({"nested2": {"key1": "value1", "key2": "value2"}})
        SessionJsonMem.remove("nested2::key1")
        are_equal(SessionJsonMem.get("nested2::key1"), null)
        are_equal(SessionJsonMem.get("nested2::key2"), "value2")
    }

    describe memory_session_mem_with_array {
        SessionJsonMem.set({"array": [1, 2, 3]})
        are_equal(SessionJsonMem.get("array")[0], 1)
        are_equal(SessionJsonMem.get("array")[1], 2)
        are_equal(SessionJsonMem.get("array")[2], 3)
    }

    describe memory_AuditLogMem_append_and_read {
        AuditLogMem.append("First log entry")
        AuditLogMem.append("Second log entry")
        var logs = AuditLogMem.read()
        are_equal(logs[0], "First log entry")
        are_equal(logs[1], "Second log entry")
    }

    // json.stringify is the inverse of json.parse: it turns a value built or
    // read from memory back into JSON text, so it can be handed to fs.write
    // (or any other native op) — round-tripping SessionJsonMem's content
    // through a file confirms the two operations agree on shape.
    describe memory_session_mem_stringify_roundtrips_through_a_file {
        SessionJsonMem.set({"key1": "value1", "key2": "value2"})
        var snapshot = json.stringify({
            "key1": SessionJsonMem.get("key1"),
            "key2": SessionJsonMem.get("key2")
        })
        fs.write(".mhl/session_mem_export.json", snapshot)

        var restored = json.parse(fs.read(".mhl/session_mem_export.json"))
        are_equal(restored.key1, "value1")
        are_equal(restored.key2, "value2")
    }

    // cmd.exec's argv-array form passes each element straight to the
    // process, with no whitespace splitting — a memory value containing
    // spaces (e.g. a commit message) survives as a single argument, which
    // the plain string form of cmd.exec cannot guarantee.
    describe memory_session_mem_value_survives_cmd_exec_argv {
        SessionJsonMem.set("commit_message", "feat: complete feature #1 - with spaces")
        var message = SessionJsonMem.get("commit_message")

        var result = cmd.exec(["echo", "-n", message])
        are_equal(result.exit_code, 0)
        are_equal(result.stdout, message)
    }

    // fs.append is the progress.txt use case: one line per completed
    // feature, added without reading the whole file back first — each
    // line here comes from a value already sitting in memory.
    describe memory_session_mem_value_appended_as_a_progress_line {
        SessionJsonMem.set("last_feature", "auth")
        var feature = SessionJsonMem.get("last_feature")

        fs.append(".mhl/progress.txt", "Feature ${feature}: PASS\n")
        fs.append(".mhl/progress.txt", "Feature checkout: PASS\n")

        var lines = fs.read(".mhl/progress.txt").trim().split("\n")
        are_equal(lines.size(), 2)
        are_equal(lines[0], "Feature auth: PASS")
        are_equal(lines[1], "Feature checkout: PASS")
    }
}