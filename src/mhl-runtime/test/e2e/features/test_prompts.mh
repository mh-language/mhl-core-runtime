use {SecurityAuditPrompt, SecurityExpertRole, SystemPrompt} from "fixtures/prompts.mh"
use {Echo} from "fixtures/agents.mh"

test test_prompts {
    describe prompt_renders_declared_template {
        var response = Echo.run(prompt: SecurityAuditPrompt(
            file_path: "user_info.mh",
            code_content: "var user = {name: 'John Doe', age: 30};"
        ))
        are_equal(response, "Você é um especialista em segurança de software.\n    Analise o arquivo 'user_info.mh' abaixo:\n\n    ```\n    var user = {name: 'John Doe', age: 30};\n    ```\n\n    Identifique vulnerabilidades (OWASP Top 10) e retorne correções objetivas.")
    }

    describe prompt_inline_interpolated_string {
        var last_error = "index out of range"
        var response = Echo.run(prompt: "Corrija: ${last_error}")
        are_equal(response, "Corrija: index out of range")
    }

    describe prompt_nested_inside_another_prompt {
        var response = Echo.run(prompt: SystemPrompt(
            role: SecurityExpertRole(),
            task: "Revise o pull request #42."
        ))
        are_equal(response, "Você é um especialista em segurança de software.\n\n    Revise o pull request #42.")
    }
}
