export agent Echo {
    command: "echo"
}

// ClaudeCLI mirrors a real `claude -p <prompt> --agent <flow> --permission-mode
// bypassPermissions --output-format stream-json --verbose` invocation, with
// the command swapped for echo so tests can assert on the exact argv instead
// of calling the real `claude` binary.
export agent MockClaudeCLI {
    command: "echo"
    cache: { ttl: 1m }
    args: [
        "-p", "${prompt}",
        "--agent", "security-audit",
        "--permission-mode", "bypassPermissions",
        "--output-format", "stream-json",
        "--json-schema", "{\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}}, \"required\": [\"message\"]}",
        "--verbose"
    ]
}

export agent ClaudeCLI {
    engine: "cli/claude-code"
    command: "claude"
    args: [
        "-p", "${prompt}",
        "--permission-mode", "bypassPermissions",
        "--output-format", "stream-json",
        "--json-schema", "{\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}}, \"required\": [\"message\"]}",
        "--verbose"
    ]
}

export agent OllamaCLI {
    engine: "ollama/phi4"
    endpoint: "http://localhost:11434"
    temperature: 0.2
}

// GeminiAPI calls the Gemini REST API directly. mhl's agent engines are
// currently limited to `cli/*` (subprocess) and `ollama/*` (local HTTP) —
// there is no generic HTTP/API engine yet — so a real HTTP API is reached by
// wrapping `curl` in a `sh -c` subprocess instead. `${prompt}` can only
// substitute a whole args element (not text embedded inside a larger
// string), so it is passed as a positional arg and picked up as `$1` inside
// the script; GEMINI_API_KEY is expanded by the shell from the real process
// environment, since mhl's own env() is only evaluated for mcp_server
// blocks, not agent args.
export agent GeminiAPI {
    command: "sh"
    args: [
        "-c",
        "curl -s -X POST \"https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=$GEMINI_API_KEY\" -H \"Content-Type: application/json\" -d '{\"contents\":[{\"parts\":[{\"text\":\"'\"$1\"'\"}]}]}'",
        "gemini-api",
        "${prompt}"
    ]

    retry: {
        max_attempts: 3
        delay: 2s
        retry_on: [500, 503, "rate_limit", "timeout"]
    }

    // Cascata acionada se o modelo primário falhar após esgotar o retry —
    // mesmo provedor, modelo mais leve/barato como segunda tentativa, já
    // que ainda não há um segundo provedor (OpenAI/Anthropic) cadastrado
    // como agent neste fixture.
    fallback: [ClaudeCLI]
}

// GeminiStructuredAPI is GeminiAPI plus `schema:` support, using the same
// curl-in-`sh -c` technique. `${schema}` has the same "whole args element
// only" limitation as `${prompt}`, so it's a second positional arg, picked
// up as `$2` — but unlike `$1` (spliced in as a JSON *string* value, quoted
// on both sides: `"'"$1"'"`), `$2` has to land as a raw JSON *object*
// (Gemini's `generationConfig.responseSchema`, matching its documented
// structured-output config), so it's spliced with no surrounding quotes:
// `"responseSchema":'"$2"'`. Whatever schemaText the caller passed for
// `schema:` must therefore already be a valid JSON object body itself
// (mhl's own `schemaText` is a plain interpolated string — see
// resolveAgentStringArg, agent.go — it is not validated as JSON before
// reaching here, unlike the ollama/* engine's Format field, which is sent
// as real embedded JSON and so fails at encoding time on malformed input).
export agent GeminiStructuredAPI {
    command: "sh"
    args: [
        "-c",
        "curl -s -X POST \"https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=$GEMINI_API_KEY\" -H \"Content-Type: application/json\" -d '{\"contents\":[{\"parts\":[{\"text\":\"'\"$1\"'\"}]}],\"generationConfig\":{\"responseMimeType\":\"application/json\",\"responseSchema\":'\"$2\"'}}'",
        "gemini-structured-api",
        "${prompt}",
        "${schema}"
    ]

    retry: {
        max_attempts: 3
        delay: 2s
        retry_on: [500, 503, "rate_limit", "timeout"]
    }
}

// MockGeminiStructuredAPI is GeminiStructuredAPI with `curl ... -d` swapped
// for `printf '%s'` on the exact same quoted-and-spliced JSON body, so a
// test can assert on the literal payload mhl builds — including that
// `responseSchema` lands as real nested JSON, not a string — without
// needing network access or GEMINI_API_KEY. See test_agents.mh's
// gemini_structured_api_splices_schema_as_a_json_object describe block.
export agent MockGeminiStructuredAPI {
    command: "sh"
    args: [
        "-c",
        "printf '%s' '{\"contents\":[{\"parts\":[{\"text\":\"'\"$1\"'\"}]}],\"generationConfig\":{\"responseMimeType\":\"application/json\",\"responseSchema\":'\"$2\"'}}'",
        "gemini-structured-api",
        "${prompt}",
        "${schema}"
    ]
}