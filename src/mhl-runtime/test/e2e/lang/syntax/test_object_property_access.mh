test test_object_property_access {
    describe object_property_access {
        var obj = {"key1": "value1", "key2": "value2"}
        are_equal(obj.key1, "value1")
        are_equal(obj.key2, "value2")
    }

    describe object_property_access_with_exception {
        var obj = {"key1": "value1"}
        try {
            var value = obj.key2 // Accessing a non-existent key throws an exception
        } catch (e) {
            are_equal(e, "field \"key2\" not found")
        }
    }

    describe object_property_access_with_nested_objects {
        var obj = {"key1": {"nestedKey1": "nestedValue1"}, "key2": "value2"}
        are_equal(obj.key1.nestedKey1, "nestedValue1")
        are_equal(obj.key2, "value2")
    }

    describe object_property_access_with_arrays {
        var obj = {"key1": [1, 2, 3], "key2": "value2"}
        are_equal(obj.key1[0], 1)
        are_equal(obj.key1[1], 2)
        are_equal(obj.key1[2], 3)
        are_equal(obj.key2, "value2")
    }

    describe object_property_access_with_complex_structure {
        var obj = {"key1": {"nestedKey1": [1, 2, 3]}, "key2": "value2"}
        are_equal(obj.key1.nestedKey1[0], 1)
        are_equal(obj.key1.nestedKey1[1], 2)
        are_equal(obj.key1.nestedKey1[2], 3)
        are_equal(obj.key2, "value2")
    }

    describe object_property_access_with_non_existent_nested_key {
        var obj = {"key1": {"nestedKey1": "nestedValue1"}}

        try {
            var value = obj.key1.nestedKey2 // Accessing a non-existent nested key throws an exception
        } catch (e) {
            are_equal(e, "field \"nestedKey2\" not found")
        }
    }

    describe object_property_access_with_non_existent_array_index {
        var obj = {"key1": [1, 2, 3]}

        try {
            var value = obj.key1[3] // Accessing a non-existent array index throws an exception
        } catch (e) {
            are_equal(e, "index 3 out of range (size 3)")
        }
    }

    describe object_get_keys_and_values {
        var obj = {"key1": "value1", "key2": "value2", "key3": "value3"}
        are_equal(obj.keys(), ["key1", "key2", "key3"])
        are_equal(obj.values(), ["value1", "value2", "value3"])
    }

    describe object_dynamic_key_access {
        var obj = {"key1": "value1", "key2": "value2"}
        var key = "key1"
        are_equal(obj[key], "value1")
        key = "key2"
        are_equal(obj[key], "value2")
    }

    describe object_dynamic_key_access_with_computed_key {
        // The key isn't a literal anywhere -- it's built at runtime, proving
        // obj[...] reads by whatever string the expression evaluates to,
        // not by a name baked in at parse time like obj.field is.
        var obj = {"key1": "value1"}
        var suffix = "1"
        are_equal(obj["key" + suffix], "value1")
    }

    describe object_dynamic_key_access_with_exception {
        var obj = {"key1": "value1"}
        var key = "key2"
        try {
            var value = obj[key] // Accessing a non-existent key throws an exception
        } catch (e) {
            are_equal(e, "field \"key2\" not found")
        }
    }

    describe object_dynamic_key_access_with_non_string_key {
        var obj = {"key1": "value1"}
        try {
            var value = obj[0] // Object keys must be strings, not numbers
        } catch (e) {
            are_equal(e, "object key must be a string, got number")
        }
    }

    describe object_dynamic_key_access_with_nested_objects {
        var obj = {"key1": {"nestedKey1": "nestedValue1"}, "key2": "value2"}
        var outerKey = "key1"
        var innerKey = "nestedKey1"
        are_equal(obj[outerKey][innerKey], "nestedValue1")
    }

    describe object_dynamic_key_access_mixed_with_array {
        var obj = {"key1": [1, 2, 3]}
        var key = "key1"
        are_equal(obj[key][0], 1)
        are_equal(obj[key][1], 2)
        are_equal(obj[key][2], 3)
    }

    describe object_dynamic_key_write {
        var obj = {"key1": "value1"}
        var key = "key2"
        obj[key] = "value2"
        are_equal(obj.key1, "value1")
        are_equal(obj.key2, "value2")
        are_equal(obj[key], "value2")
    }

    describe object_dynamic_key_write_overwrites_existing_key {
        var obj = {"key1": "value1"}
        var key = "key1"
        obj[key] = "updated"
        are_equal(obj.key1, "updated")
    }

    describe object_dynamic_key_write_with_nested_objects {
        var obj = {"key1": {"nestedKey1": "nestedValue1"}}
        var outerKey = "key1"
        var innerKey = "nestedKey1"
        obj[outerKey][innerKey] = "updated"
        are_equal(obj.key1.nestedKey1, "updated")
    }
}
