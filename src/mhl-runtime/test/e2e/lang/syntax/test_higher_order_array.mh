test test_higher_order_array {
    describe filter {
        var numbers = [1, 2, 3, 4, 5, 6]
        var even = numbers.filter((n) -> n % 2 == 0)
        are_equal(even.size(), 3)
        are_equal(even[0], 2)
        are_equal(even[1], 4)
        are_equal(even[2], 6)
    }

    describe filter_no_match_returns_empty_array {
        var numbers = [1, 3, 5]
        var even = numbers.filter((n) -> n % 2 == 0)
        are_equal(even.size(), 0)
    }

    describe filter_does_not_mutate_the_source_array {
        var numbers = [1, 2, 3, 4]
        var even = numbers.filter((n) -> n % 2 == 0)
        are_equal(numbers.size(), 4)
    }

    describe filter_predicate_must_return_a_boolean {
        var result = ""
        try {
            var bad = [1, 2].filter((n) -> n)
            result = "no error"
        } catch (e) {
            result = "Caught exception: ${e}"
        }
        are_equal(result, "Caught exception: filter() predicate must return a boolean, got number")
    }

    describe find {
        var users = [
            {"id": 1, "status": "pending"},
            {"id": 2, "status": "passed"},
            {"id": 3, "status": "pending"}
        ]
        var found = users.find((u) -> u.status == "passed")
        are_equal(found.id, 2)
    }

    describe find_no_match_returns_null {
        var users = [{"id": 1, "status": "pending"}]
        var found = users.find((u) -> u.status == "passed")
        is_null(found)
    }

    describe sort_by_number {
        var features = [
            {"id": 3, "priority": 2},
            {"id": 1, "priority": 1},
            {"id": 2, "priority": 3}
        ]
        var sorted = features.sort_by((f) -> f.priority)
        are_equal(sorted[0].id, 1)
        are_equal(sorted[1].id, 3)
        are_equal(sorted[2].id, 2)
    }

    describe sort_by_string {
        var names = ["charlie", "alice", "bob"]
        var sorted = names.sort_by((n) -> n)
        are_equal(sorted, ["alice", "bob", "charlie"])
    }

    describe sort_by_does_not_mutate_the_source_array {
        var numbers = [3, 1, 2]
        var sorted = numbers.sort_by((n) -> n)
        are_equal(numbers, [3, 1, 2])
        are_equal(sorted, [1, 2, 3])
    }

    describe sort_by_key_must_be_number_or_string {
        var result = ""
        try {
            var bad = [1, 2].sort_by((n) -> true)
            result = "no error"
        } catch (e) {
            result = "Caught exception: ${e}"
        }
        are_equal(result, "Caught exception: sort_by() key must be a number or string, got bool")
    }

    // Reproduces FeatureStore.NextPending() (dotnet/Flows.Development):
    // among the pending features whose dependencies are all already
    // passed, pick the one with the highest priority (lowest number).
    describe deterministic_feature_selection {
        var passedIds = [10]
        var features = [
            {"id": 20, "status": "pending", "priority": 2, "dependsOn": [10]},
            {"id": 30, "status": "pending", "priority": 1, "dependsOn": [99]},
            {"id": 40, "status": "pending", "priority": 3, "dependsOn": []}
        ]
        var ready = features
            .filter((f) -> f.status == "pending")
            .filter((f) -> f.dependsOn.filter((d) -> !passedIds.contains(d)).is_empty())
            .sort_by((f) -> f.priority)

        are_equal(ready.size(), 2)
        var next = ready[0]
        are_equal(next.id, 20)
    }
}
