// This test verifies the behavior of logical operations in MHL.
test test_logical_operations {
    describe logical_and_operation {
        var valueA = true && true
        are_equal(valueA, true)

        var valueB = true && false
        are_equal(valueB, false)

        var valueC = false && true
        are_equal(valueC, false)

        var valueD = false && false
        are_equal(valueD, false)
    }

    describe logical_or_operation {
        var valueE = true || true
        are_equal(valueE, true)

        var valueF = true || false
        are_equal(valueF, true)

        var valueG = false || true
        are_equal(valueG, true)

        var valueH = false || false
        are_equal(valueH, false)
    }
}