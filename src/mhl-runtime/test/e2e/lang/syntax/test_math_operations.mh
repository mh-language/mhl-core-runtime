test test_float_operations {
    describe float_sum_operations {
        var A = 0.001
        var B = 0.002
        var C = A + B
        are_equal(C, 0.003)
    }

    describe float_subtraction_operations {
        var A = 0.005
        var B = 0.002
        var C = A - B
        are_equal(C, 0.003)
    }

    describe float_multiplication_operations {
        var A = 0.001
        var B = 0.002
        var C = A * B
        are_equal(C, 0.000002)
    }
    
    describe float_division_operations {
        var A = 0.006
        var B = 0.002
        var C = A / B
        are_equal(C, 3.0)
    }
}

test test_integer_operations {
    describe integer_sum_operations {
        var A = 1
        var B = 2
        var C = A + B
        are_equal(C, 3)
    }

    describe integer_subtraction_operations {
        var A = 5
        var B = 2
        var C = A - B
        are_equal(C, 3)
    }

    describe integer_multiplication_operations {
        var A = 1
        var B = 2
        var C = A * B
        are_equal(C, 2)
    }
    
    describe integer_division_operations {
        var A = 6
        var B = 2
        var C = A / B
        are_equal(C, 3)
    }

    describe module_integer_operations {
        var A = 6
        var B = 2
        var C = A % B
        are_equal(C, 0)
    }
}