use {FeatureStore, RunConfig, PlanReader} from "modules/tools/feature.tool.mh"
use {Codex} from "modules/agents/harness.agents.mh"
use {SetupPrompt} from "modules/prompts/setup.prompt.mh"

loop pipeline FeatureCycle {
    stop_when: FeatureStore.pending() == 0
    max_iterations: 10

    var planfile = ".mhl/plan.json"

    step Start {
        if (FeatureStore.pending() > 0) {
            log("setup: ${FeatureStore.pending()} features ainda pendentes")
            goto Bearings
        }
        
        FeatureStore.reset()
        RunConfig.reset()

        try {
            //fs.delete(planfile)
        } catch (e) {
            log("[dev] failed to clear ${planfile}: ${e}")
        }

        if (PlanReader.import() == false) {
            log("[dev] no plan found at ${planfile}, skipping import")
            goto Setup
        }
        

        log("setup: nenhuma feature pendente, ciclo de desenvolvimento concluido")
    }

    step Setup {
        var schemaPath = ".mhl/setup_schema.json"
        fs.write(schemaPath, json.stringify({
            "type": "object",
            "properties": {
                "TARGET_DIR": {"type": "string"},
                "VERIFY_CMD": {"type": "string"},
                "input_tokens": {"type": "integer"},
                "cached_input_tokens": {"type": "integer"},
                "cache_write_input_tokens": {"type": "integer"},
                "output_tokens": {"type": "integer"},
                "reasoning_output_tokens": {"type": "integer"}
            },
            "required": ["TARGET_DIR", "VERIFY_CMD", "input_tokens", "cached_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_output_tokens"],
            "additionalProperties": false
        }))

        // Codex's `--output-schema` (unlike Claude's `--json-schema`) takes a
        // *file path*, not inline JSON text -- see the doc comment on the
        // Codex agent in modules/agents.mh.
        var result = Codex.run(prompt: SetupPrompt(), schema: schemaPath)
        var json_raw = json.parse(result)

        var targetDir = json_raw.TARGET_DIR
        var verifyCmd = json_raw.VERIFY_CMD

        RunConfig.set("target_dir", targetDir)
        RunConfig.set("verify_cmd", verifyCmd)

        log("setup: TARGET_DIR=${targetDir}, VERIFY_CMD=${verifyCmd}")

    }


    // step Bearings {
    //     var features = FeatureStore.get("features", null)
    //     if (features == null) {
