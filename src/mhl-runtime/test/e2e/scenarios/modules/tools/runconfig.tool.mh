export memory RunConfigMemory {
    type: "json"
    path: ".mhl/run_config.json"
}

export tool RunConfig {
    get(key: string) -> RunConfigMemory.get("config::${key}", null)
    set(key: string, value) -> RunConfigMemory.set("config::${key}", value)

    reset() -> RunConfigMemory.set("config", null)
}