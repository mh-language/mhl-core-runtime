export agent Reviewer {
    engine: "cli/claude-code"
    command: "claude"
    args: ["-p", "${prompt}"]
    retry: { max_attempts: 3, delay: 2s, retry_on: [500, "timeout"] }
    cache: { ttl: 1h, storage: "disk" }
    rate_limit: { requests_per_minute: 30, concurrency: 2 }
    before: () -> {
        return {
            diff: execution.git_diff(),
            issue: GitHub.call("get_issue", { number: 42 })
        }
    }
    after: () -> {
        log("review is ${result.size()} characters")
    }
    fallback: [Backup]
}

agent Backup {
    command: "echo"
}

tool execution {
    git_diff() -> git.diff()
}

extension mcp GitHub {
    transport: "http"
    url: "https://mcp.example.test"
    headers: { "Authorization": "Bearer " + env("MCP_TOKEN") }
}
