/**
Run free-form data queries (DQL) against PostgreSQL from a workflow and get
rows back as JSON objects. Read-only by default: the pool sets
default_transaction_read_only=on, so PostgreSQL rejects any write. The first
argument is the SQL; the rest bind to $1, $2, … (never interpolated). Not
the `store` KV backend — see mhl-store-postgres.
**/
extensible sql {
    manifest: {
        id: "dev.mhl.sql-postgres",
        version: "0.1.0",
        api_version: "1",
        executable: "bin/mhl-sql-postgres",
        permissions: {
            network: ["*"],
            secrets: []
        }
    }

    properties: {
        dsn: string /// Full connection string (URL or libpq keyword/value). Use env("DATABASE_URL"). Wins over the discrete fields.
        host: string /// Database host (used when `dsn` is unset).
        port: string /// Database port. Default 5432.
        dbname: string /// Database name.
        user: string /// Role name. Prefer a least-privilege, SELECT-only role.
        password: string /// Role password. Use env("PGPASSWORD"); the host resolves and redacts it.
        sslmode: string /// libpq sslmode: disable | prefer (default) | require | verify-ca | verify-full.
        read_only: bool /// Default true — sets default_transaction_read_only=on so writes are rejected by PostgreSQL, and `exec` is disabled. Set false to allow DML via `exec`.
        max_rows: number /// Maximum rows a single `query` may return before it errors (guard against unbounded SELECTs). Default 10000; 0 = unlimited.
        max_conns: number /// Connection-pool size. Default 4.
        statement_timeout: string /// Per-statement server-side timeout as a Go duration ("10s", "500ms"). Unset = server default.
        log: string /// Optional path to append a JSON-lines wire trace (SQL head + arg count, never values) for debugging.
    }

    query(sql: string, args: any[]) -> object[] /// Run a SELECT; every row is an object keyed by column name. args bind to $1, $2, ….
    queryRow(sql: string, args: any[]) -> object /// The first row, or null when the query yields none.
    queryValue(sql: string, args: any[]) -> any /// The first column of the first row, or null.
    exec(sql: string, args: any[]) -> number /// Run a single DML/DDL statement, returning the affected-row count. Errors unless read_only is false.
    execScript(sql: string) -> number /// Run a multi-statement DDL/DML script in ONE transaction (all-or-nothing). No bind parameters. Errors unless read_only is false. Use `exec` for statements that cannot run in a transaction (CREATE INDEX CONCURRENTLY, VACUUM, CREATE DATABASE).
}
