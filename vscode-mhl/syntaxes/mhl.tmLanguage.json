{
  "name": "MHL",
  "scopeName": "source.mhl",
  "fileTypes": [
    "mh"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#function-parameters"
    },
    {
      "include": "#route-targets"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#control"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#types"
    },
    {
      "include": "#assertions"
    },
    {
      "include": "#calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "The one block-comment shape mhl recognizes: a leading `/** ... **/` header on an `extensible` declaration, read back as its kind-level documentation. Highlighted as a doc comment wherever it appears; the compiler only honors it at the very start of a file.",
          "name": "comment.block.documentation.mhl",
          "begin": "/\\*\\*",
          "end": "\\*\\*/"
        },
        {
          "comment": "A `///` doc-comment on an `extensible` property or method line — the rest of the line, recovered by the extension loader's own scan off the raw source. Not a distinct grammar token (the third `/` is just more comment text to the lexer), but worth its own scope so it reads as documentation rather than a plain code comment.",
          "name": "comment.line.documentation.mhl",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.mhl",
          "match": "//.*$"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "type alias declaration: `type ReviewInput = { ... }` — the declared name and its right-hand side are types",
          "begin": "\\b(type)[ \\t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \\t]*(=)[ \\t]*",
          "beginCaptures": {
            "1": {
              "name": "storage.type.declaration.mhl"
            },
            "2": {
              "name": "entity.name.type.mhl"
            },
            "3": {
              "name": "keyword.operator.mhl"
            }
          },
          "end": "(?=//)|$",
          "patterns": [
            {
              "include": "#type-annotation"
            }
          ]
        },
        {
          "comment": "enum declaration name: `enum Severity { ... }`",
          "match": "\\b(enum)[ \\t]+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.mhl"
            },
            "2": {
              "name": "entity.name.type.mhl"
            }
          }
        },
        {
          "comment": "result type with no param: `workflow Broken: Status {`",
          "match": "\\b(pipeline|workflow)[ \\t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \\t]*:[ \\t]*([a-zA-Z_][a-zA-Z0-9_]*(?:\\[\\])*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.mhl"
            },
            "2": {
              "name": "entity.name.function.mhl"
            },
            "3": {
              "name": "entity.name.type.mhl"
            }
          }
        },
        {
          "comment": "per-line pipeline input: `input level: Severity = Severity.Low`",
          "begin": "\\b(input)[ \\t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \\t]*(:)[ \\t]*",
          "beginCaptures": {
            "1": {
              "name": "storage.type.declaration.mhl"
            },
            "2": {
              "name": "entity.name.tag.property.mhl"
            }
          },
          "end": "(?=[ \\t]*(?:=|//))|$",
          "patterns": [
            {
              "include": "#type-annotation"
            }
          ]
        },
        {
          "name": "storage.type.declaration.mhl",
          "match": "\\b(from|import|as|export|extension|extensible|agent|router|memory|tool|loop|partial|pipeline|workflow|prompt|parallel|step|route|timeout|input|test|describe|type|enum)\\b"
        },
        {
          "comment": "`max <N>` header clause on a `loop pipeline` / `loop workflow` — matched only after the declaration name so it never lights up an ordinary identifier, `.max(` call, or `max:` key",
          "match": "(?<=\\b(?:pipeline|workflow)[ \\t]{1,64}[a-zA-Z_][a-zA-Z0-9_]{0,128}[ \\t]{1,64})(max)(?=[ \\t]+[0-9])",
          "captures": {
            "1": {
              "name": "storage.type.declaration.mhl"
            }
          }
        },
        {
          "comment": "`max <N>` after a typed signature — workflow W(req: In): Out max 3 { — `max N {` only ever occurs in a declaration header",
          "match": "(?<=[)\\]a-zA-Z0-9_])[ \\t]+(max)(?=[ \\t]+[0-9]+[ \\t]*\\{)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.mhl"
            }
          }
        },
        {
          "comment": "`entry` header clause on a step — entry step Name { ... } — matched only directly before `step` so it never lights up an ordinary identifier, a step literally named Entry, or an `entry:`/`entry(` property or call",
          "match": "\\b(entry)(?=[ \\t]+step\\b)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.mhl"
            }
          }
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.mhl",
          "match": "\\b(if|else|while|for|in|try|catch|finally|fail|pause|complete|return|mem|var|const|match|goto|break|spawn|wait|self)\\b"
        },
        {
          "comment": "`ref { ... }` / `ref (expr)` — contextual: a bare `ref` stays an identifier",
          "name": "keyword.other.ref.mhl",
          "match": "\\bref(?=\\s*[{(])"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mhl",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "contentName": "string.unquoted.multiline.mhl",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.mhl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mhl",
              "match": "\\\\."
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.mhl",
          "match": "\\b\\d+(?:\\.\\d+)?(?:ms|s|m|h|d)\\b"
        },
        {
          "name": "constant.numeric.mhl",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.mhl",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "interpolation": {
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.begin.mhl"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.end.mhl"
        }
      },
      "contentName": "meta.embedded.expression.mhl",
      "patterns": [
        {
          "include": "#interpolation-expression"
        }
      ]
    },
    "interpolation-expression": {
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#constants"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)(?=[ \\t]*\\()",
          "captures": {
            "1": {
              "name": "entity.name.namespace.mhl"
            },
            "2": {
              "name": "punctuation.accessor.mhl"
            },
            "3": {
              "name": "entity.name.function.mhl"
            }
          }
        },
        {
          "include": "#calls"
        },
        {
          "include": "#interpolation-object"
        },
        {
          "name": "variable.other.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "punctuation.accessor.mhl",
          "match": "\\?\\.|\\."
        }
      ]
    },
    "interpolation-object": {
      "comment": "A bare { ... } object literal inside a ${...} interpolation — e.g. ${ {a: 1} }. Without its own begin/end region here, the object's own closing '}' would be consumed by #interpolation's end pattern instead, ending the interpolation early and leaving the rest (another closing '}', or any trailing text) miscolored as plain string content.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#interpolation-expression"
        }
      ]
    },
    "function-parameters": {
      "patterns": [
        {
          "comment": "A typed pipeline/workflow signature: workflow Review(req: ReviewInput): ReviewOutput { ... }",
          "begin": "\\b(?:(partial)[ \\t]+)?(?:(loop)[ \\t]+)?(pipeline|workflow)[ \\t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \\t]*\\([ \\t]*",
          "beginCaptures": {
            "1": {
              "name": "storage.type.declaration.mhl"
            },
            "2": {
              "name": "storage.type.declaration.mhl"
            },
            "3": {
              "name": "storage.type.declaration.mhl"
            },
            "4": {
              "name": "entity.name.function.mhl"
            }
          },
          "end": "\\)",
          "patterns": [
            {
              "include": "#parameter-list"
            }
          ]
        },
        {
          "comment": "A workflow-local reusable route declaration: route Generate(artifact: string) { ... }",
          "begin": "\\b(route)[ \\t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \\t]*\\([ \\t]*",
          "beginCaptures": {
            "1": {
              "name": "storage.type.declaration.mhl"
            },
            "2": {
              "name": "entity.name.function.mhl"
            }
          },
          "end": "\\)",
          "patterns": [
            {
              "include": "#parameter-list"
            }
          ]
        },
        {
          "begin": "\\b(prompt)[ \\t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \\t]*\\([ \\t]*",
          "beginCaptures": {
            "1": {
              "name": "storage.type.declaration.mhl"
            },
            "2": {
              "name": "entity.name.function.mhl"
            }
          },
          "end": "\\)",
          "patterns": [
            {
              "include": "#parameter-list"
            }
          ]
        },
        {
          "begin": "^[ \\t]*([a-zA-Z_][a-zA-Z0-9_]*)[ \\t]*\\([ \\t]*(?=[^()\\n]*\\)[ \\t]*(?::[^()\\n]+)?[ \\t]*->)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.mhl"
            }
          },
          "end": "\\)",
          "patterns": [
            {
              "include": "#parameter-list"
            }
          ]
        },
        {
          "begin": "\\([ \\t]*(?=[^()\\n]*\\)[ \\t]*->)",
          "end": "\\)",
          "patterns": [
            {
              "include": "#parameter-list"
            }
          ]
        }
      ]
    },
    "route-targets": {
      "patterns": [
        {
          "comment": "A static step destination in a goto match or reusable route arm. fail(...) remains a normal control keyword/call.",
          "match": "->[ \\t]*([a-zA-Z_][a-zA-Z0-9_]*)(?=[ \\t]*(?://|$))",
          "captures": {
            "1": {
              "name": "entity.name.label.mhl"
            }
          }
        },
        {
          "comment": "The reusable route invoked by goto Generate(artifact).",
          "match": "\\b(goto)([ \\t]+)([a-zA-Z_][a-zA-Z0-9_]*)(?=[ \\t]*\\()",
          "captures": {
            "1": {
              "name": "keyword.control.mhl"
            },
            "3": {
              "name": "entity.name.function.mhl"
            }
          }
        }
      ]
    },
    "parameter-list": {
      "patterns": [
        {
          "name": "variable.parameter.function.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=[ \\t]*:)"
        },
        {
          "name": "variable.parameter.function.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=[ \\t]*(?:,|\\)))"
        },
        {
          "begin": ":[ \\t]*",
          "end": "(?=,|\\)|=)",
          "patterns": [
            {
              "include": "#type-annotation"
            }
          ]
        },
        {
          "comment": "a parameter's default value: `lang: string = \"en\"` — an expression, not part of the type",
          "begin": "=[ \\t]*",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.mhl"
            }
          },
          "end": "(?=,|\\))",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#calls"
            }
          ]
        }
      ]
    },
    "type-annotation": {
      "patterns": [
        {
          "name": "storage.type.mhl",
          "match": "\\b(?:string|number|int|integer|float|bool|boolean|array|object|any|prompt|void)\\b"
        },
        {
          "include": "#type-object-shape"
        },
        {
          "comment": "a user-declared type (`type X = ...` alias or `enum`) — any other identifier in a type position",
          "name": "entity.name.type.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "type-object-shape": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "name": "entity.name.tag.property.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=[ \\t]*\\??[ \\t]*:)"
        },
        {
          "comment": "optional shape field marker: base?: string",
          "name": "keyword.operator.optional.mhl",
          "match": "\\?(?=[ \\t]*:)"
        },
        {
          "begin": ":[ \\t]*",
          "end": "(?=,|\\})|$",
          "patterns": [
            {
              "include": "#type-annotation"
            }
          ]
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "entity.name.tag.property.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\??\\s*:)"
        },
        {
          "name": "variable.other.mhl",
          "match": "\\$\\{?[a-zA-Z_][a-zA-Z0-9_.]*\\}?"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": ":\\s*((?:string|number|int|integer|float|bool|boolean|array|object|any|prompt|void)\\b(?:\\[\\])*)",
          "captures": {
            "1": {
              "name": "storage.type.mhl"
            }
          }
        },
        {
          "comment": "a user-declared return/result type right after a parameter list — `workflow W(req: In): Out`, `m(p: Point): Point ->` (builtins are the rule above)",
          "match": "(?<=\\))[ \\t]*:[ \\t]*(?!(?:string|number|int|integer|float|bool|boolean|array|object|any|prompt|void)\\b)([a-zA-Z_][a-zA-Z0-9_]*(?:\\[\\])*)",
          "captures": {
            "1": {
              "name": "entity.name.type.mhl"
            }
          }
        },
        {
          "comment": "A bare `-> Type` return type, as on an `extensible` method signature (`get(key: string) -> any`) — distinguished from an ordinary `-> expr(...)` tool-method body by requiring the type word to run straight to end-of-line or a comment, since a real call is always followed by `(`.",
          "match": "->[ \\t]*((?:string|number|int|integer|float|bool|boolean|array|object|any|prompt|void)\\b(?:\\[\\])*)(?=[ \\t]*(?://|$))",
          "captures": {
            "1": {
              "name": "storage.type.mhl"
            }
          }
        }
      ]
    },
    "assertions": {
      "patterns": [
        {
          "name": "support.function.assertion.mhl",
          "match": "\\b(are_equal|are_not_equal|not_equal|is_true|is_false|is_null|not_null|greater_than|less_than|greater_than_or_equal|less_than_or_equal|includes|incomplete)\\b(?=\\s*\\()"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_.]*(?=\\s*\\()"
        },
        {
          "name": "keyword.operator.mhl",
          "match": "\\+=|==|!=|<=|>=|&&|\\|\\||[+*/%<>=!-]"
        }
      ]
    }
  }
}
