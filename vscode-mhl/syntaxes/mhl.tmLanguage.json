{
  "name": "MHL",
  "scopeName": "source.mhl",
  "fileTypes": [
    "mh"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#function-parameters"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#control"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#types"
    },
    {
      "include": "#assertions"
    },
    {
      "include": "#calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mhl",
          "match": "//.*$"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "storage.type.declaration.mhl",
          "match": "\\b(from|import|as|export|extension|agent|memory|tool|loop|pipeline|workflow|prompt|parallel|step|timeout|input|test|describe|type|enum)\\b"
        },
        {
          "comment": "`max <N>` header clause on a `loop pipeline` / `loop workflow` — matched only after the declaration name so it never lights up an ordinary identifier, `.max(` call, or `max:` key",
          "match": "(?<=\\b(?:pipeline|workflow)[ \\t]{1,64}[a-zA-Z_][a-zA-Z0-9_]{0,128}[ \\t]{1,64})(max)(?=[ \\t]+[0-9])",
          "captures": {
            "1": {
              "name": "storage.type.declaration.mhl"
            }
          }
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.mhl",
          "match": "\\b(if|else|while|for|in|try|catch|finally|fail|pause|return|mem|var|const|match|goto|break|spawn|wait|self)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mhl",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "contentName": "string.unquoted.multiline.mhl",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.mhl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mhl",
              "match": "\\\\."
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.mhl",
          "match": "\\b\\d+(?:\\.\\d+)?(?:ms|s|m|h|d)\\b"
        },
        {
          "name": "constant.numeric.mhl",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.mhl",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "interpolation": {
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.begin.mhl"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.end.mhl"
        }
      },
      "contentName": "meta.embedded.expression.mhl",
      "patterns": [
        {
          "include": "#interpolation-expression"
        }
      ]
    },
    "interpolation-expression": {
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#constants"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)(?=[ \\t]*\\()",
          "captures": {
            "1": {
              "name": "entity.name.namespace.mhl"
            },
            "2": {
              "name": "punctuation.accessor.mhl"
            },
            "3": {
              "name": "entity.name.function.mhl"
            }
          }
        },
        {
          "include": "#calls"
        },
        {
          "name": "variable.other.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "punctuation.accessor.mhl",
          "match": "\\?\\.|\\."
        }
      ]
    },
    "function-parameters": {
      "patterns": [
        {
          "begin": "\\b(prompt)[ \\t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \\t]*\\([ \\t]*",
          "beginCaptures": {
            "1": {
              "name": "storage.type.declaration.mhl"
            },
            "2": {
              "name": "entity.name.function.mhl"
            }
          },
          "end": "\\)",
          "patterns": [
            {
              "include": "#parameter-list"
            }
          ]
        },
        {
          "begin": "^[ \\t]*([a-zA-Z_][a-zA-Z0-9_]*)[ \\t]*\\([ \\t]*(?=[^()\\n]*\\)[ \\t]*(?::[^()\\n]+)?[ \\t]*->)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.mhl"
            }
          },
          "end": "\\)",
          "patterns": [
            {
              "include": "#parameter-list"
            }
          ]
        },
        {
          "begin": "\\([ \\t]*(?=[^()\\n]*\\)[ \\t]*->)",
          "end": "\\)",
          "patterns": [
            {
              "include": "#parameter-list"
            }
          ]
        }
      ]
    },
    "parameter-list": {
      "patterns": [
        {
          "name": "variable.parameter.function.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=[ \\t]*:)"
        },
        {
          "name": "variable.parameter.function.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=[ \\t]*(?:,|\\)))"
        },
        {
          "begin": ":[ \\t]*",
          "end": "(?=,|\\))",
          "patterns": [
            {
              "include": "#type-annotation"
            }
          ]
        }
      ]
    },
    "type-annotation": {
      "patterns": [
        {
          "name": "storage.type.mhl",
          "match": "\\b(?:string|number|int|integer|float|bool|boolean|array|object|any|prompt)\\b"
        },
        {
          "include": "#type-object-shape"
        }
      ]
    },
    "type-object-shape": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "name": "entity.name.tag.property.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=[ \\t]*:)"
        },
        {
          "begin": ":[ \\t]*",
          "end": "(?=,|\\})",
          "patterns": [
            {
              "include": "#type-annotation"
            }
          ]
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "entity.name.tag.property.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*:)"
        },
        {
          "name": "variable.other.mhl",
          "match": "\\$\\{?[a-zA-Z_][a-zA-Z0-9_.]*\\}?"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": ":\\s*((?:string|number|int|integer|float|bool|boolean|array|object|any|prompt)\\b(?:\\[\\])*)",
          "captures": {
            "1": {
              "name": "storage.type.mhl"
            }
          }
        }
      ]
    },
    "assertions": {
      "patterns": [
        {
          "name": "support.function.assertion.mhl",
          "match": "\\b(are_equal|are_not_equal|not_equal|is_true|is_false|is_null|not_null|greater_than|less_than|greater_than_or_equal|less_than_or_equal|includes|incomplete)\\b(?=\\s*\\()"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.mhl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_.]*(?=\\s*\\()"
        },
        {
          "name": "keyword.operator.mhl",
          "match": "\\+=|==|!=|<=|>=|&&|\\|\\||[+*/%<>=!-]"
        }
      ]
    }
  }
}