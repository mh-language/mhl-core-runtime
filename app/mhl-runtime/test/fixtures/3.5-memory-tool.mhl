memory session_mem {
    type: "kv"
    store: "memory"
}
memory project_rag {
    type: "vector"
    provider: "chroma"
    path: "./.mhl/vector_db"
}
tool execution {
    run_tests() -> cmd.exec("dotnet test", timeout: 120s)
    get_diff() -> git.diff(target: "HEAD~1", capture: true)
    read_file(path: string) -> fs.read(path)
    write_file(path: string, content: string) -> fs.write(path, content)
}
